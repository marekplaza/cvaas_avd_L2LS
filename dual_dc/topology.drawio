                <mxCell id="RoutingiP2PDC1-46" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Adresacja P2P DC1&lt;/b&gt; (uplinki, MLAG, DCI)&lt;table border=&#39;1&#39; cellpadding=&#39;2&#39; style=&#39;border-collapse:collapse;font-size:10px;margin-top:4px&#39;&gt;&lt;tr&gt;&lt;th&gt;urządzenie A&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP A&lt;/th&gt;&lt;th&gt;urządzenie B&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP B&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.101.10.1/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.101.10.0/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.101.10.3/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.101.10.2/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.101.10.5/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.101.10.4/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.101.10.7/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.101.10.6/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l01&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.101.20.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-wew-l02&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.101.20.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l01&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.101.21.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-wew-l02&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.101.21.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-priv-l03&lt;/td&gt;&