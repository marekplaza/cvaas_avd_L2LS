/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-ext-l06&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.101.10.23/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet6&lt;/td&gt;&lt;td&gt;10.101.10.22/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-ext-l05&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.101.20.8/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-ext-l06&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.101.20.9/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-ext-l05&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.101.21.8/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-ext-l06&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.101.21.9/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet7 DCI&lt;/td&gt;&lt;td&gt;10.100.0.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet7&lt;/td&gt;&lt;td&gt;10.100.0.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet8 DCI&lt;/td&gt;&lt;td&gt;10.100.0.2/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet8&lt;/td&gt;&lt;td&gt;10.100.0.3/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet7 DCI&lt;/td&gt;&lt;td&gt;10.100.0.4/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet7&lt;/td&gt;&lt;td&gt;10.100.0.5/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet8 DCI&lt;/td&gt;&lt;td&gt;10.100.0.6/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet8&lt;/td&gt;&lt;td&gt;10.100.0.7/31&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
