peer-link: Et3 + Et4 (żółte)&lt;br&gt;• leaf Et5 → firewall (LACP, Port-Channel5 na parze MLAG); FW: Et1/2 wew, Et3/4 priv, Et5/6 ext&lt;br&gt;• DCI (czerwone, grube): 4 × /31 spine ↔ spine, pełna siatka 2 × 2, MTU 9214&lt;br&gt;• mgmt: sieć containerlab 10.30.0.0/16 (marpla_dualdc_mgmt)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#999999;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1100" height="110" as="geometry"/></mxCell><mxCell id="Fizyczna-81" value="&lt;b&gt;Numery seryjne&lt;/b&gt;&lt;br&gt;CAFECAFECAFE{dc}101/102 – spine&#x27;y&lt;br&gt;CAFECAFECAFE{dc}111–116 – leafy" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#999999;spacing=8;" vertex="1" parent="1"><mxGeometry x="1140" y="900" width="400" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="Logiczna" name="Logiczna"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Logiczna-1" value="&lt;b&gt;Dual DC + DCI – topologia logiczna&lt;/b&gt; (eBGP underlay + eBGP EVPN, EVPN multi-domain gateway)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="30" as="geometry"/></mxCell><mxCell id="Logiczna-2" value="DC1 · marpla-DC1 · AS 65100–65103" style="fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=16;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1000" height="900" as="geometry"/></mxCell><mxCell id="Logiczna-3" value="&lt;b&gt;marpla-dc-1-s01&lt;/b&gt;&lt;br&gt;AS 65100 · Lo0 10.101.0.1&lt;br&gt;VTEP Lo1 10.101.3.1&lt;br&gt;EVPN rout