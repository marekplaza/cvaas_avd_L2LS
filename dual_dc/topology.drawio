l id="RoutingiP2PDC2-44" value="&lt;b&gt;MLAG&lt;/b&gt; peer-link Po3 (Et3 + Et4)&lt;br&gt;Vlan4094 (MLAG): 10.102.20.8/31 ⇄ 10.102.20.9&lt;br&gt;Vlan4093 (iBGP L3, AS 65203): 10.102.21.8/31 ⇄ 10.102.21.9" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1085" y="710" width="470" height="60" as="geometry"/></mxCell><mxCell id="RoutingiP2PDC2-45" value="Leafy: eBGP underlay po /31 do obu spine&#x27;ów (IPv4-UNDERLAY-PEERS) + eBGP EVPN Lo0 ↔ Lo0 do obu RS (EVPN-OVERLAY-PEERS, multihop 3). Spine&#x27;y wysyłają do leafów underlay przez RM-UNDERLAY-TO-LEAFS (bez loopbacków bram DC1)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=11;fontColor=#0050ef;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="1540" height="40" as="geometry"/></mxCell><mxCell id="RoutingiP2PDC2-46" value="&lt;b&gt;Adresacja P2P DC2&lt;/b&gt; (uplinki, MLAG, DCI)&lt;table border=&#x27;1&#x27; cellpadding=&#x27;2&#x27; style=&#x27;border-collapse:collapse;font-size:10px;margin-top:4px&#x27;&gt;&lt;tr&gt;&lt;th&gt;urządzenie A&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP A&lt;/th&gt;&lt;th&gt;urządzenie B&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP B&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.1/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.0/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.3/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.2/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.5/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.4/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ma