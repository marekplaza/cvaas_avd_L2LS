                <mxCell id="RoutingiP2PDC2-45" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=11;fontColor=#0050ef;" value="Leafy: eBGP underlay po /31 do obu spine&#39;ów (IPv4-UNDERLAY-PEERS) + eBGP EVPN Lo0 ↔ Lo0 do obu RS (EVPN-OVERLAY-PEERS, multihop 3). Spine&#39;y wysyłają do leafów underlay przez RM-UNDERLAY-TO-LEAFS (bez loopbacków bram DC1)." vertex="1">
                    <mxGeometry height="40" width="1540" x="40" y="465" as="geometry"/>
                </mxCell>
                <mxCell id="RoutingiP2PDC2-46" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Adresacja P2P DC2&lt;/b&gt; (uplinki, MLAG, DCI)&lt;table border=&#39;1&#39; cellpadding=&#39;2&#39; style=&#39;border-collapse:collapse;font-size:10px;margin-top:4px&#39;&gt;&lt;tr&gt;&lt;th&gt;urządzenie A&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP A&lt;/th&gt;&lt;th&gt;urządzenie B&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP B&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.1/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.0/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.3/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.2/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.5/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.4/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.7/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.6/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.102.20.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.102.20.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.102.21.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.102.21.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.9/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet3&lt;/td&gt;&lt;td&gt;10.102.10.8/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.11/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet3&lt;/td&gt;&lt;td&gt;10.102.10.10/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.13/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet4&lt;/td&gt;&lt;td&gt;10.102.10.12/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.15/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet4&lt;/td&gt;&lt;td&gt;10.102.10.14/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.102.20.4/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.102.20.5/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.102.21.4/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.102.21.5/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.17/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet5&lt;/td&gt;&lt;td&gt;10.102.10.16/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.19/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet5&lt;/td&gt;&lt;td&gt;10.102.10.18/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.21/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet6&lt;/td&gt;&lt;td&gt;10.102.10.20/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.23/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet6&lt;/td&gt;&lt;td&gt;10.102.10.22/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.102.20.8/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.102.20.9/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.102.21.8/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.102.21.9/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet7 DCI&lt;/td&gt;&lt;td&gt;10.100.0.1/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet7&lt;/td&gt;&lt;td&gt;10.100.0.0/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet8 DCI&lt;/td&gt;&lt;td&gt;10.100.0.7/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet8&lt;/td&gt;&lt;td&gt;10.100.0.6/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet7 DCI&lt;/td&gt;&lt;td&gt;10.100.0.5/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet7&lt;/td&gt;&lt;td&gt;10.100.0.4/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet8 DCI&lt;/td&gt;&lt;td&gt;10.100.0.3/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet8&lt;/td&gt;&lt;td&gt;10.100.0.2/31&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="760" width="900" x="20" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="RoutingiP2PDC2-47" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Gdzie są RR?&lt;/b&gt;&lt;br&gt;Overlay jest eBGP, więc zamiast iBGP route reflectorów rolę „RR” pełnią &lt;b&gt;route servery EVPN&lt;/b&gt; – spine&#39;y każdego DC (purpurowe, znaczek RS). Leafy mają sesje EVPN tylko do nich; RS przekazują trasy bez zmiany next-hopa (next-hop-unchanged), więc tunele VXLAN idą leaf ↔ leaf w obrębie DC.&lt;br&gt;&lt;br&gt;Ten sam spine jest też &lt;b&gt;EVPN Gateway&lt;/b&gt;: trasy z drugiego DC ogłasza leafom z next-hopem = własny VTEP, więc leafy nie tunelują do drugiego DC.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pule DC2&lt;/b&gt;: Lo0 spine 10.102.0.0/24 · Lo0 leaf 10.102.1.0/24 · VTEP leaf 10.102.2.0/24 · VTEP GW 10.102.3.0/24 · uplinki 10.102.10.0/24 (wszystkie P2P to /31) · MLAG 10.102.20.0/24 · MLAG L3 10.102.21.0/24 · DCI 10.100.0.0/29" vertex="1">
                    <mxGeometry height="300" width="640" x="960" y="890" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="RD i RT" name="RD i RT">
        <mxGraphModel dx="2313" dy="2297" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1900" math="0" shadow="0">
