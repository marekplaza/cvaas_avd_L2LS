                </mxCell>
                <mxCell id="RDiRT-7" edge="1" parent="1" source="RDiRT-4" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=10;" target="RDiRT-6" value="eBGP EVPN multihop&lt;br&gt;EVPN-OVERLAY-CORE&lt;br&gt;(DCI)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;dc2-priv-l03 / l04&lt;/b&gt;&lt;br&gt;&lt;i&gt;leaf, AS 65202&lt;/i&gt;&lt;br&gt;&lt;u&gt;import&lt;/u&gt;&lt;br&gt;&lt;br&gt;widzi tylko RD bram DC2 (10.102.0.1:310, 10.102.0.2:310)&lt;br&gt;import po RT 310:310 → VLAN 310, 30:30 → VRF PRIV&lt;br&gt;NH 10.102.3.1 / 10.102.3.2 – tunel VXLAN tylko do bram DC2" vertex="1">
                    <mxGeometry height="170" width="400" x="1665" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-9" edge="1" parent="1" source="RDiRT-6" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=10;" target="RDiRT-8" value="eBGP EVPN&lt;br&gt;EVPN-OVERLAY-PEERS">
