                <mxCell id="RoutingiP2PDC2-45" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=11;fontColor=#0050ef;" value="Leafy: eBGP underlay po /31 do obu spine&#39;ów (IPv4-UNDERLAY-PEERS) + eBGP EVPN Lo0 ↔ Lo0 do obu RS (EVPN-OVERLAY-PEERS, multihop 3) + jako brama strefy eBGP EVPN multihop do pary tej samej strefy w DC1 (EVPN-OVERLAY-CORE). RTC z RM-RTC-LOCAL-ONLY: para ogłasza tylko RT swojej strefy." vertex="1">
                    <mxGeometry height="40" width="1540" x="40" y="465" as="geometry"/>
                </mxCell>
                <mxCell id="RoutingiP2PDC2-46" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Adresacja P2P DC2&lt;/b&gt; (uplinki, MLAG, DCI)&lt;table border=&#39;1&#39; cellpadding=&#39;2&#39; style=&#39;border-collapse:collapse;font-size:10px;margin-top:4px&#39;&gt;&lt;tr&gt;&lt;th&gt;urządzenie A&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP A&lt;/th&gt;&lt;th&gt;urządzenie B&lt;/th&gt;&lt;th&gt;interfejs&lt;/th&gt;&lt;th&gt;IP B&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.1/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.0/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.3/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.2/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.5/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.4/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.7/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.6/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.102.20.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.102.20.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.102.21.0/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.102.21.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.9/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet3&lt;/td&gt;&lt;td&gt;10.102.10.8/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.11/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet3&lt;/td&gt;&lt;td&gt;10.102.10.10/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.13/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet4&lt;/td&gt;&lt;td&gt;10.102.10.12/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.15/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet4&lt;/td&gt;&lt;td&gt;10.102.10.14/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.102.20.4/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.102.20.5/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.102.21.4/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.102.21.5/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.17/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet5&lt;/td&gt;&lt;td&gt;10.102.10.16/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.19/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet5&lt;/td&gt;&lt;td&gt;10.102.10.18/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Ethernet1&lt;/td&gt;&lt;td&gt;10.102.10.21/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet6&lt;/td&gt;&lt;td&gt;10.102.10.20/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Ethernet2&lt;/td&gt;&lt;td&gt;10.102.10.23/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet6&lt;/td&gt;&lt;td&gt;10.102.10.22/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Vlan4094 MLAG&lt;/td&gt;&lt;td&gt;10.102.20.8/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Vlan4094&lt;/td&gt;&lt;td&gt;10.102.20.9/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;Vlan4093 iBGP&lt;/td&gt;&lt;td&gt;10.102.21.8/31&lt;/td&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;Vlan4093&lt;/td&gt;&lt;td&gt;10.102.21.9/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet7 DCI&lt;/td&gt;&lt;td&gt;10.100.0.1/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet7&lt;/td&gt;&lt;td&gt;10.100.0.0/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;Ethernet8 DCI&lt;/td&gt;&lt;td&gt;10.100.0.7/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet8&lt;/td&gt;&lt;td&gt;10.100.0.6/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet7 DCI&lt;/td&gt;&lt;td&gt;10.100.0.5/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;Ethernet7&lt;/td&gt;&lt;td&gt;10.100.0.4/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;Ethernet8 DCI&lt;/td&gt;&lt;td&gt;10.100.0.3/31&lt;/td&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;Ethernet8&lt;/td&gt;&lt;td&gt;10.100.0.2/31&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="760" width="900" x="20" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="RoutingiP2PDC2-47" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Gdzie są RR?&lt;/b&gt;&lt;br&gt;Overlay jest eBGP, więc zamiast iBGP route reflectorów rolę „RR” pełnią &lt;b&gt;route servery EVPN&lt;/b&gt; – spine&#39;y każdego DC (purpurowe, znaczek RS). Leafy mają sesje EVPN tylko do nich; RS przekazują trasy bez zmiany next-hopa (next-hop-unchanged), więc tunele VXLAN idą leaf ↔ leaf w obrębie DC.&lt;br&gt;&lt;br&gt;Spine&#39;y &lt;b&gt;nie są&lt;/b&gt; bramami: każda strefa ma własną bramę – swoją parę leafów – i własne sesje EVPN przez DCI do pary tej samej strefy w drugim DC. Tunele VXLAN przez DCI idą para ↔ para tej samej strefy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pule DC2&lt;/b&gt;: Lo0 spine 10.102.0.0/24 · Lo0 leaf 10.102.1.0/24 · VTEP leaf 10.102.2.0/24 · uplinki 10.102.10.0/24 (wszystkie P2P to /31) · MLAG 10.102.20.0/24 · MLAG L3 10.102.21.0/24 · DCI 10.100.0.0/29" vertex="1">
                    <mxGeometry height="300" width="640" x="960" y="890" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="RD i RT" name="RD i RT">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="RDiRT-1" value="&lt;b&gt;RD i RT – schemat i rozgłaszanie tras EVPN przez bramy&lt;/b&gt; (dane z AVD structured_configs; ścieżka trasy sprawdzona na labie)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-2" value="&lt;b&gt;Przykład:&lt;/b&gt; trasa type-2 MAC/IP węzła FW DC1 (10.3.10.11, MAC 001c.7331.18f2) w VLAN 310 / strefa priv – przez DCI idzie wprost między bramami strefy priv (parami leafów); RT bez zmian, RD domain remote = RD bramy" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="20" y="60" width="2100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-3" value="&lt;b&gt;dc1-priv-l03 (+ l04)&lt;/b&gt;&lt;br&gt;&lt;i&gt;leaf + EVPN GW strefy priv, AS 65102&lt;/i&gt;&lt;br&gt;&lt;u&gt;origin (Local) + re-origination → domain remote&lt;/u&gt;&lt;br&gt;&lt;br&gt;lokalnie: RD 10.101.1.3:310 (l04: 10.101.1.4:310)&lt;br&gt;RT 310:310 (MAC-VRF) + 30:30 (VRF PRIV)&lt;br&gt;NH 10.101.2.3 (VTEP MLAG)&lt;br&gt;do DC2: &lt;b&gt;domain remote, RD 10.101.1.3:310&lt;/b&gt;, ten sam NH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="30" y="100" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-4" value="&lt;b&gt;dc1-s01 / s02&lt;/b&gt;&lt;br&gt;&lt;i&gt;EVPN route server DC1, AS 65100&lt;/i&gt;&lt;br&gt;&lt;u&gt;tylko domena lokalna DC1&lt;/u&gt;&lt;br&gt;&lt;br&gt;trzyma trasę z RD 10.101.1.x:310 (next-hop-unchanged)&lt;br&gt;nie jest bramą – trasa do DC2 &lt;b&gt;nie&lt;/b&gt; idzie przez spine&#39;y&lt;br&gt;(spine&#39;y przenoszą tylko underlay DCI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="575" y="100" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-5" value="eBGP EVPN&lt;br&gt;EVPN-OVERLAY-PEERS&lt;br&gt;(lokalnie)" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="RDiRT-3" target="RDiRT-4">
                    <mxGeometry x="0" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-6" value="&lt;b&gt;dc2-priv-l03 / l04&lt;/b&gt;&lt;br&gt;&lt;i&gt;leaf + EVPN GW strefy priv, AS 65202&lt;/i&gt;&lt;br&gt;&lt;u&gt;odbiór z domain remote + import&lt;/u&gt;&lt;br&gt;&lt;br&gt;odbiera &lt;b&gt;bezpośrednio&lt;/b&gt; od dc1-priv-l03/l04 (EVPN-OVERLAY-CORE)&lt;br&gt;jako &lt;i&gt;remote&lt;/i&gt;, RD 10.101.1.3:310 / 10.101.1.4:310&lt;br&gt;import po RT 310:310 → VLAN 310, 30:30 → VRF PRIV&lt;br&gt;NH 10.101.2.3 – tunel VXLAN wprost do pary priv DC1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="100" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-7" value="eBGP EVPN multihop&lt;br&gt;EVPN-OVERLAY-CORE&lt;br&gt;l03/l04 ⇄ l03/l04" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="RDiRT-4" target="RDiRT-6">
                    <mxGeometry x="0" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-8" value="&lt;b&gt;dc2-s01 / s02&lt;/b&gt;&lt;br&gt;&lt;i&gt;EVPN route server DC2, AS 65200&lt;/i&gt;&lt;br&gt;&lt;u&gt;nie dostaje trasy z DC1&lt;/u&gt;&lt;br&gt;&lt;br&gt;zna tylko trasy stref DC2 (np. FW DC2: RD 10.102.1.3:310)&lt;br&gt;trasa z DC1 kończy się na bramie strefy priv DC2&lt;br&gt;(sprawdzone: show bgp evpn na dc2-s01)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="1665" y="100" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-9" value="nie wysyła&lt;br&gt;do RS DC2" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="RDiRT-6" target="RDiRT-8">
                    <mxGeometry x="0" relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-10" value="&lt;b&gt;Route Targets&lt;/b&gt; – identyczne w DC1 i DC2 (te same definicje tenantów), unikalne per strefa&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;font-size:11px;margin-top:6px&#39;&gt;&lt;tr&gt;&lt;th&gt;strefa&lt;/th&gt;&lt;th&gt;instancja&lt;/th&gt;&lt;th&gt;VNI&lt;/th&gt;&lt;th&gt;RT (import/export)&lt;/th&gt;&lt;th&gt;RT evpn domain remote (bramy = pary strefy)&lt;/th&gt;&lt;th&gt;gdzie&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f0f0f0&#39;&gt;&lt;td&gt;&lt;b&gt;ext&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VRF EXT (IP-VRF, type-5)&lt;/td&gt;&lt;td&gt;1009000&lt;/td&gt;&lt;td&gt;&lt;b&gt;10:10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;10:10 (type-5 inter-domain)&lt;/td&gt;&lt;td&gt;pary strefy w DC1 i DC2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 110 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;1000110&lt;/td&gt;&lt;td&gt;&lt;b&gt;110:110&lt;/b&gt;&lt;/td&gt;&lt;td&gt;110:110&lt;/td&gt;&lt;td&gt;pary strefy w DC1 + DC2 (przez DCI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 121 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;1000121&lt;/td&gt;&lt;td&gt;&lt;b&gt;121:121&lt;/b&gt;&lt;/td&gt;&lt;td&gt;– (nie idzie przez DCI)&lt;/td&gt;&lt;td&gt;tylko DC1 (evpn_l2_multi_domain: false)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 122 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;1000122&lt;/td&gt;&lt;td&gt;&lt;b&gt;122:122&lt;/b&gt;&lt;/td&gt;&lt;td&gt;– (nie idzie przez DCI)&lt;/td&gt;&lt;td&gt;tylko DC2 (evpn_l2_multi_domain: false)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f0f0f0&#39;&gt;&lt;td&gt;&lt;b&gt;wew&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VRF WEW (IP-VRF, type-5)&lt;/td&gt;&lt;td&gt;2009000&lt;/td&gt;&lt;td&gt;&lt;b&gt;20:20&lt;/b&gt;&lt;/td&gt;&lt;td&gt;20:20 (type-5 inter-domain)&lt;/td&gt;&lt;td&gt;pary strefy w DC1 i DC2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 210 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;2000210&lt;/td&gt;&lt;td&gt;&lt;b&gt;210:210&lt;/b&gt;&lt;/td&gt;&lt;td&gt;210:210&lt;/td&gt;&lt;td&gt;pary strefy w DC1 + DC2 (przez DCI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 221 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;2000221&lt;/td&gt;&lt;td&gt;&lt;b&gt;221:221&lt;/b&gt;&lt;/td&gt;&lt;td&gt;– (nie idzie przez DCI)&lt;/td&gt;&lt;td&gt;tylko DC1 (evpn_l2_multi_domain: false)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 222 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;2000222&lt;/td&gt;&lt;td&gt;&lt;b&gt;222:222&lt;/b&gt;&lt;/td&gt;&lt;td&gt;– (nie idzie przez DCI)&lt;/td&gt;&lt;td&gt;tylko DC2 (evpn_l2_multi_domain: false)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#f0f0f0&#39;&gt;&lt;td&gt;&lt;b&gt;priv&lt;/b&gt;&lt;/td&gt;&lt;td&gt;VRF PRIV (IP-VRF, type-5)&lt;/td&gt;&lt;td&gt;3009000&lt;/td&gt;&lt;td&gt;&lt;b&gt;30:30&lt;/b&gt;&lt;/td&gt;&lt;td&gt;30:30 (type-5 inter-domain)&lt;/td&gt;&lt;td&gt;pary strefy w DC1 i DC2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 310 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;3000310&lt;/td&gt;&lt;td&gt;&lt;b&gt;310:310&lt;/b&gt;&lt;/td&gt;&lt;td&gt;310:310&lt;/td&gt;&lt;td&gt;pary strefy w DC1 + DC2 (przez DCI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 321 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;3000321&lt;/td&gt;&lt;td&gt;&lt;b&gt;321:321&lt;/b&gt;&lt;/td&gt;&lt;td&gt;– (nie idzie przez DCI)&lt;/td&gt;&lt;td&gt;tylko DC1 (evpn_l2_multi_domain: false)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 322 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;3000322&lt;/td&gt;&lt;td&gt;&lt;b&gt;322:322&lt;/b&gt;&lt;/td&gt;&lt;td&gt;– (nie idzie przez DCI)&lt;/td&gt;&lt;td&gt;tylko DC2 (evpn_l2_multi_domain: false)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;VLAN 399 (MAC-VRF, type-2/3)&lt;/td&gt;&lt;td&gt;3000399&lt;/td&gt;&lt;td&gt;&lt;b&gt;399:399&lt;/b&gt;&lt;/td&gt;&lt;td&gt;399:399&lt;/td&gt;&lt;td&gt;pary strefy w DC1 + DC2 (przez DCI)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
                    <mxGeometry x="20" y="300" width="1080" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-11" value="&lt;b&gt;Jak są budowane&lt;/b&gt;&lt;br&gt;• &lt;b&gt;RD MAC-VRF&lt;/b&gt; = &amp;lt;Lo0 router-id&amp;gt;:&amp;lt;VLAN ID&amp;gt; – np. 10.101.1.3:310&lt;br&gt;• &lt;b&gt;RD IP-VRF&lt;/b&gt; = &amp;lt;Lo0&amp;gt;:&amp;lt;vrf_id&amp;gt; – EXT 10, WEW 20, PRIV 30 – np. 10.101.1.3:30&lt;br&gt;• &lt;b&gt;RT MAC-VRF&lt;/b&gt; = &amp;lt;VLAN&amp;gt;:&amp;lt;VLAN&amp;gt;, &lt;b&gt;RT IP-VRF&lt;/b&gt; = &amp;lt;vrf_id&amp;gt;:&amp;lt;vrf_id&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(mac_vrf_id_base: 0 – 7-cyfrowe VNI nie zmieściłyby się w RD typu IP:liczba)&lt;br&gt;• RD jest unikalny per urządzenie (Lo0), RT wspólny dla całej strefy w obu DC&lt;br&gt;&lt;br&gt;&lt;b&gt;Bramy = pary leafów stref&lt;/b&gt;&lt;br&gt;• &lt;code&gt;rd evpn domain remote&lt;/code&gt; = ten sam &amp;lt;Lo0&amp;gt;:&amp;lt;VLAN&amp;gt; – RD tras ogłaszanych do pary strefy w drugim DC&lt;br&gt;• &lt;code&gt;route-target import export evpn domain remote&lt;/code&gt; = ten sam RT – tylko VLAN-y DCI: 110, 210, 310, 399&lt;br&gt;&amp;nbsp;&amp;nbsp;(VLAN-y lokalne: evpn_l2_multi_domain: false – bez domain remote)&lt;br&gt;• type-5 (IP-VRF) przez &lt;i&gt;next-hop-self … inter-domain&lt;/i&gt; z RT VRF-u&lt;br&gt;• bez D-path i bez Ethernet Segment bram (para MLAG = wspólny VTEP); powrót trasy do domeny lokalnej blokuje AS path drugiego leafa pary&lt;br&gt;&lt;br&gt;&lt;b&gt;RT Constraint&lt;/b&gt;: para ogłasza route serverom i bramom drugiego DC tylko członkostwo, które sama generuje (RM-RTC-LOCAL-ONLY, AS path ^$) – RT swojej strefy. Bez tego członkostwo 0/0 route serverów jednego DC przechodziłoby przez bramy do drugiego DC i route servery wysyłałyby leafom trasy wszystkich stref.&lt;br&gt;&lt;br&gt;&lt;b&gt;Separacja stref&lt;/b&gt;: tablica BGP EVPN leafa zawiera tylko trasy jego strefy; przez DCI każda strefa ma własne sesje EVPN i własne tunele VXLAN. Route servery znają trasy wszystkich stref własnego DC (bez importu)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="300" width="1000" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-12" value="&lt;b&gt;Route Distinguishers per urządzenie&lt;/b&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;font-size:10px;margin-top:6px&#39;&gt;&lt;tr&gt;&lt;th&gt;urządzenie&lt;/th&gt;&lt;th&gt;rola&lt;/th&gt;&lt;th&gt;Lo0&lt;/th&gt;&lt;th&gt;RD MAC-VRF (VLAN)&lt;/th&gt;&lt;th&gt;RD IP-VRF&lt;/th&gt;&lt;th&gt;RD domain remote&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-s01&lt;/td&gt;&lt;td&gt;route server&lt;/td&gt;&lt;td&gt;10.101.0.1&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-s02&lt;/td&gt;&lt;td&gt;route server&lt;/td&gt;&lt;td&gt;10.101.0.2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-ext-l05&lt;/td&gt;&lt;td&gt;leaf + GW ext&lt;/td&gt;&lt;td&gt;10.101.1.5&lt;/td&gt;&lt;td&gt;10.101.1.5:110, 10.101.1.5:121&lt;/td&gt;&lt;td&gt;EXT 10.101.1.5:10&lt;/td&gt;&lt;td&gt;10.101.1.5:110&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-ext-l06&lt;/td&gt;&lt;td&gt;leaf + GW ext&lt;/td&gt;&lt;td&gt;10.101.1.6&lt;/td&gt;&lt;td&gt;10.101.1.6:110, 10.101.1.6:121&lt;/td&gt;&lt;td&gt;EXT 10.101.1.6:10&lt;/td&gt;&lt;td&gt;10.101.1.6:110&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-priv-l03&lt;/td&gt;&lt;td&gt;leaf + GW priv&lt;/td&gt;&lt;td&gt;10.101.1.3&lt;/td&gt;&lt;td&gt;10.101.1.3:310, 10.101.1.3:321, 10.101.1.3:399&lt;/td&gt;&lt;td&gt;PRIV 10.101.1.3:30&lt;/td&gt;&lt;td&gt;10.101.1.3:310, 10.101.1.3:399&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-priv-l04&lt;/td&gt;&lt;td&gt;leaf + GW priv&lt;/td&gt;&lt;td&gt;10.101.1.4&lt;/td&gt;&lt;td&gt;10.101.1.4:310, 10.101.1.4:321, 10.101.1.4:399&lt;/td&gt;&lt;td&gt;PRIV 10.101.1.4:30&lt;/td&gt;&lt;td&gt;10.101.1.4:310, 10.101.1.4:399&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l01&lt;/td&gt;&lt;td&gt;leaf + GW wew&lt;/td&gt;&lt;td&gt;10.101.1.1&lt;/td&gt;&lt;td&gt;10.101.1.1:210, 10.101.1.1:221&lt;/td&gt;&lt;td&gt;WEW 10.101.1.1:20&lt;/td&gt;&lt;td&gt;10.101.1.1:210&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-1-wew-l02&lt;/td&gt;&lt;td&gt;leaf + GW wew&lt;/td&gt;&lt;td&gt;10.101.1.2&lt;/td&gt;&lt;td&gt;10.101.1.2:210, 10.101.1.2:221&lt;/td&gt;&lt;td&gt;WEW 10.101.1.2:20&lt;/td&gt;&lt;td&gt;10.101.1.2:210&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s01&lt;/td&gt;&lt;td&gt;route server&lt;/td&gt;&lt;td&gt;10.102.0.1&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-s02&lt;/td&gt;&lt;td&gt;route server&lt;/td&gt;&lt;td&gt;10.102.0.2&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l05&lt;/td&gt;&lt;td&gt;leaf + GW ext&lt;/td&gt;&lt;td&gt;10.102.1.5&lt;/td&gt;&lt;td&gt;10.102.1.5:110, 10.102.1.5:122&lt;/td&gt;&lt;td&gt;EXT 10.102.1.5:10&lt;/td&gt;&lt;td&gt;10.102.1.5:110&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-ext-l06&lt;/td&gt;&lt;td&gt;leaf + GW ext&lt;/td&gt;&lt;td&gt;10.102.1.6&lt;/td&gt;&lt;td&gt;10.102.1.6:110, 10.102.1.6:122&lt;/td&gt;&lt;td&gt;EXT 10.102.1.6:10&lt;/td&gt;&lt;td&gt;10.102.1.6:110&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l03&lt;/td&gt;&lt;td&gt;leaf + GW priv&lt;/td&gt;&lt;td&gt;10.102.1.3&lt;/td&gt;&lt;td&gt;10.102.1.3:310, 10.102.1.3:322, 10.102.1.3:399&lt;/td&gt;&lt;td&gt;PRIV 10.102.1.3:30&lt;/td&gt;&lt;td&gt;10.102.1.3:310, 10.102.1.3:399&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-priv-l04&lt;/td&gt;&lt;td&gt;leaf + GW priv&lt;/td&gt;&lt;td&gt;10.102.1.4&lt;/td&gt;&lt;td&gt;10.102.1.4:310, 10.102.1.4:322, 10.102.1.4:399&lt;/td&gt;&lt;td&gt;PRIV 10.102.1.4:30&lt;/td&gt;&lt;td&gt;10.102.1.4:310, 10.102.1.4:399&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l01&lt;/td&gt;&lt;td&gt;leaf + GW wew&lt;/td&gt;&lt;td&gt;10.102.1.1&lt;/td&gt;&lt;td&gt;10.102.1.1:210, 10.102.1.1:222&lt;/td&gt;&lt;td&gt;WEW 10.102.1.1:20&lt;/td&gt;&lt;td&gt;10.102.1.1:210&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;marpla-dc-2-wew-l02&lt;/td&gt;&lt;td&gt;leaf + GW wew&lt;/td&gt;&lt;td&gt;10.102.1.2&lt;/td&gt;&lt;td&gt;10.102.1.2:210, 10.102.1.2:222&lt;/td&gt;&lt;td&gt;WEW 10.102.1.2:20&lt;/td&gt;&lt;td&gt;10.102.1.2:210&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
                    <mxGeometry x="20" y="890" width="2110" height="640" as="geometry"/>
