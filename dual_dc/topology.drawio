                    <mxGeometry height="30" width="1700" x="20" y="15" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=13;" value="&lt;b&gt;Przykład:&lt;/b&gt; trasa type-2 MAC/IP węzła FW DC1 (10.3.10.11, MAC 001c.7331.18f2) w VLAN 310 / strefa priv – RT nie zmienia się na całej ścieżce, zmieniają się RD i next-hop na bramach" vertex="1">
                    <mxGeometry height="30" width="2100" x="20" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;dc1-priv-l03 (+ l04)&lt;/b&gt;&lt;br&gt;&lt;i&gt;leaf, AS 65102&lt;/i&gt;&lt;br&gt;&lt;u&gt;origin (Local)&lt;/u&gt;&lt;br&gt;&lt;br&gt;RD 10.101.1.3:310 (l04: 10.101.1.4:310)&lt;br&gt;RT 310:310 (MAC-VRF) + 30:30 (VRF PRIV)&lt;br&gt;NH 10.101.2.3 (VTEP MLAG)" vertex="1">
                    <mxGeometry height="170" width="400" x="30" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;dc1-s01 / s02&lt;/b&gt;&lt;br&gt;&lt;i&gt;RS + EVPN GW, AS 65100&lt;/i&gt;&lt;br&gt;&lt;u&gt;re-origination → domain remote&lt;/u&gt;&lt;br&gt;&lt;br&gt;lokalnie: przekazuje bez zmian (next-hop-unchanged)&lt;br&gt;do DC2: &lt;b&gt;RD 10.101.0.1:310&lt;/b&gt; (s02: 10.101.0.2:310)&lt;br&gt;RT 310:310 + 30:30&lt;br&gt;&lt;b&gt;NH 10.101.3.1&lt;/b&gt; (VTEP bramy)" vertex="1">
                    <mxGeometry height="170" width="400" x="575" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-5" edge="1" parent="1" source="RDiRT-3" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#2d7600;labelBackgroundColor=#ffffff;fontSize=10;" target="RDiRT-4" value="eBGP EVPN&lt;br&gt;EVPN-OVERLAY-PEERS">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="RDiRT-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;dc2-s01 / s02&lt;/b&gt;&lt;br&gt;&lt;i&gt;RS + EVPN GW, AS 65200&lt;/i&gt;&lt;br&gt;&lt;u&gt;re-origination → domain local&lt;/u&gt;&lt;br&gt;&lt;br&gt;odbiera jako &lt;i&gt;remote&lt;/i&gt; (RD 10.101.0.x:310)&lt;br&gt;do leafów DC2: &lt;b&gt;RD 10.102.0.1:310&lt;/b&gt; (s02: 10.102.0.2:310)&lt;br&gt;RT 310:310 + 30:30&lt;br&gt;&lt;b&gt;NH 10.102.3.1&lt;/b&gt;" vertex="1">
