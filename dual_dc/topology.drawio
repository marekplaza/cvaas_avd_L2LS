                <mxCell id="RoutingiP2PDC2-44" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=11;" value="&lt;b&gt;MLAG&lt;/b&gt; peer-link Po3 (Et3 + Et4)&lt;br&gt;Vlan4094 (MLAG): 10.102.20.8/31 ⇄ 10.102.20.9&lt;br&gt;Vlan4093 (iBGP L3, AS 65203): 10.102.21.8/31 ⇄ 10.102.21.9" vertex="1">
